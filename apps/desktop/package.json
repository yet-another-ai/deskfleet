{
  "name": "@deskfleet/desktop",
  "productName": "deskfleet",
  "desktopName": "io.github.yet_another_ai.deskfleet.desktop",
  "version": "0.1.0",
  "description": "Manage a team's AI agents and working environments across machines.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.ts",
    "package": "electron-builder --publish never",
    "package:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@deskfleet/client": "workspace:*",
    "@deskfleet/components": "workspace:*",
    "@deskfleet/daemon": "workspace:*",
    "@deskfleet/native": "workspace:*",
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "@lobehub/icons-static-svg": "1.101.0",
    "@lucide/vue": "1.62.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-sfc": "3.6.0-rc.13",
    "@vue/test-utils": "2.5.1",
    "@vueuse/core": "15.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.1",
    "electron-updater": "6.8.9",
    "happy-dom": "21.0.4",
    "markdown-it": "15.0.3",
    "pinia": "4.1.0",
    "sharp": "0.35.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unocss": "66.12.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.6.0-rc.13",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.13"
  }
}
