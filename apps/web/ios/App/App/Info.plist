	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>DeskFleetAppGroupIdentifier</key>
	<string>$(DESKFLEET_OUTLINE_AUDIO_GROUP)</string>
	<key>CFBundleDisplayName</key>
	<string>$(DESKFLEET_IOS_DISPLAY_NAME)</string>
