	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.yetanother.deskfleet</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ai.yetanother.deskfleet</string>
			</array>
		</dict>
