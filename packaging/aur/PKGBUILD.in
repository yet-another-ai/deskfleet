# Maintainer: Delton Ding <dsh0416@gmail.com>
# SPDX-License-Identifier: 0BSD
# Generated by scripts/package-aur-release.ts; edit packaging/aur/PKGBUILD.in.
pkgname=deskfleet-bin
pkgver=@PKGVER@
pkgrel=1
_upstreamVersion=@VERSION@
pkgdesc="Manage a team's AI agents and working environments across machines"
arch=(@ARCHITECTURES@)
url='https://github.com/yet-another-ai/deskfleet'
license=('Apache-2.0' 'MIT' 'BSD-3-Clause' '0BSD')
depends=(
  'alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'git' 'glib2' 'glibc' 'gtk3'
  'hicolor-icon-theme' 'libcups' 'libgcc' 'libx11' 'libxcb' 'libxcomposite'
  'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr' 'mesa'
  'nspr' 'nss' 'pango' 'systemd-libs' 'xdg-utils'
)
optdepends=(
  'libnotify: desktop notifications'
  'libsecret: credential storage through a Secret Service provider'
  'gst-plugins-base-libs: remote desktop capture and video conversion'
  'gst-plugins-bad-libs: remote desktop video parsers and NVIDIA encoding'
  'gst-plugin-va: remote desktop VA-API encoding with a compatible driver'
  'gst-plugin-pipewire: Wayland remote desktop capture'
  'xdg-desktop-portal: Wayland permissions with a compatible desktop portal backend'
)
provides=("deskfleet=$pkgver")
conflicts=('deskfleet')
# Preserve the bundled Electron executable and its native addon unchanged.
options=('!strip' '!debug')
source=('deskfleet' 'io.github.yet_another_ai.deskfleet.desktop' 'icon.png' 'LICENSE' 'LICENSE.packaging')
sha256sums=(@HELPER_HASHES@)
@ARCHIVE_SOURCES@

package() {
  local upstream_arch
  case "$CARCH" in
    x86_64) upstream_arch=x64 ;;
    aarch64) upstream_arch=arm64 ;;
  esac
  local bundle="$srcdir/deskfleet-$_upstreamVersion-linux-$upstream_arch"
  install -dm755 "$pkgdir/opt/deskfleet"
  cp -a "$bundle/." "$pkgdir/opt/deskfleet/"
  # Keep Chromium's sandbox available on hosts without unprivileged user namespaces.
  chmod 4755 "$pkgdir/opt/deskfleet/chrome-sandbox"
  install -Dm755 "$srcdir/deskfleet" "$pkgdir/usr/bin/deskfleet"
  install -Dm644 "$srcdir/io.github.yet_another_ai.deskfleet.desktop" \
    "$pkgdir/usr/share/applications/io.github.yet_another_ai.deskfleet.desktop"
  install -Dm644 "$srcdir/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/io.github.yet_another_ai.deskfleet.png"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/LICENSE.packaging" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.packaging"
  ln -s /opt/deskfleet/LICENSE.electron.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.electron.txt"
  ln -s /opt/deskfleet/LICENSES.chromium.html "$pkgdir/usr/share/licenses/$pkgname/LICENSES.chromium.html"
}
