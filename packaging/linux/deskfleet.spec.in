# Generated by scripts/package-linux-release.ts; edit packaging/linux/deskfleet.spec.in.
# Bundled Electron binaries must remain unchanged.
%global __strip /bin/true
%global debug_package %{nil}
%global __os_install_post %{nil}

Name:           deskfleet
Version:        @VERSION@
Release:        1
Summary:        AI agents and working environments across machines
License:        Apache-2.0 AND MIT AND BSD-3-Clause AND 0BSD
URL:            https://github.com/yet-another-ai/deskfleet
BuildArch:      @ARCH@
AutoReqProv:    no
Provides:       deskfleet = %{version}-%{release}

@REQUIRES@
@RECOMMENDS@

%description
DeskFleet manages a team's AI agents and working environments across
multiple machines, including remote terminals, files, and desktops.

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}/usr/lib
cp -a %{_sourcedir}/app %{buildroot}/usr/lib/deskfleet
chmod 4755 %{buildroot}/usr/lib/deskfleet/chrome-sandbox
install -Dm755 %{_sourcedir}/deskfleet %{buildroot}/usr/bin/deskfleet
install -Dm644 %{_sourcedir}/io.github.yet_another_ai.deskfleet.desktop \
  %{buildroot}/usr/share/applications/io.github.yet_another_ai.deskfleet.desktop
install -Dm644 %{_sourcedir}/icon.png \
  %{buildroot}/usr/share/icons/hicolor/256x256/apps/io.github.yet_another_ai.deskfleet.png
install -Dm644 %{_sourcedir}/LICENSE %{buildroot}/usr/share/licenses/deskfleet/LICENSE
install -Dm644 %{_sourcedir}/LICENSE.packaging %{buildroot}/usr/share/licenses/deskfleet/LICENSE.packaging
ln -s /usr/lib/deskfleet/LICENSE.electron.txt %{buildroot}/usr/share/licenses/deskfleet/LICENSE.electron.txt
ln -s /usr/lib/deskfleet/LICENSES.chromium.html %{buildroot}/usr/share/licenses/deskfleet/LICENSES.chromium.html

%files
/usr/lib/deskfleet
/usr/bin/deskfleet
/usr/share/applications/io.github.yet_another_ai.deskfleet.desktop
/usr/share/icons/hicolor/256x256/apps/io.github.yet_another_ai.deskfleet.png
/usr/share/licenses/deskfleet/LICENSE
/usr/share/licenses/deskfleet/LICENSE.packaging
/usr/share/licenses/deskfleet/LICENSE.electron.txt
/usr/share/licenses/deskfleet/LICENSES.chromium.html
